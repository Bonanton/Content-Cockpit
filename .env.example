# Copia questo file in .env.local e compila i valori reali.
# Non committare mai .env.local o qualunque file .env con chiavi vere.

# Postgres (Vercel Postgres, Neon, Supabase o altro). Richiesto per login, brand, contenuti, lead.
DATABASE_URL=postgres://user:password@host:5432/database

# Vercel AI Gateway - usato da /api/generate-content per generare i testi (agente Hermes)
AI_GATEWAY_API_KEY=

# fal.ai - usato da /api/generate-content e /api/generate-image per generare le immagini
FAL_KEY=

# URL pubblico dell'app in produzione (es. https://content-cockpit.vercel.app).
# Se non impostata, in produzione viene dedotta automaticamente da VERCEL_URL.
BETTER_AUTH_URL=
